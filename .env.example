# Copy to .env (not version-controlled) and fill with real values.
# Or simply run ./setup.sh which generates .env interactively.
# Never commit the real .env.

# Huawei Cloud MaaS (model API key from Huawei Cloud console)
MAAS_API_KEY=

# MCP server path (where mcp-opengauss is installed)
MCP_OPENGAUSS_DIR=

# GaussDB connection (RESTRICTED read-only user — SELECT/EXPLAIN only)
GAUSSDB_HOST=
GAUSSDB_PORT=8000
GAUSSDB_USER=ai_agent_ro
GAUSSDB_PASSWORD=
GAUSSDB_DBNAME=
